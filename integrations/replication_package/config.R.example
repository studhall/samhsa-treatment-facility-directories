# Copy this file to config/config.R for machine-specific local settings.
# Do not commit real API keys or restricted-data paths.

# Census API key is only needed when rebuilding CBP inputs from the Census API.
# Sys.setenv(CENSUS_KEY = "YOUR_KEY_HERE")

# Optional: override the legacy project root. By default scripts assume the legacy
# folders live one level above this replication package.
# options(tm.legacy_root = "C:/path/to/TreatmentAndMortality")

# Optional: increase Monte Carlo iterations. The default is deliberately modest.
# Sys.setenv(TM_MC_B = "500")

# SAMHSA facility data are downloaded from a pinned public release by default.
# Update these only when intentionally moving the paper to a reviewed release.
# options(tm.samhsa_release_repo = "studhall/samhsa-treatment-facility-directories")
# options(tm.samhsa_release_version = "v0.1.0")
